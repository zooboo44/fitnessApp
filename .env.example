# Copy to .env and fill in. Never commit .env.

# Long random string: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Public URL the app is reached at (used for OAuth redirect URIs). No trailing slash.
BASE_URL=http://localhost:8000

# Set to 1 when served over HTTPS (required for Sign in with Apple in production).
SESSION_COOKIE_SECURE=0

# Postgres password used by docker-compose
POSTGRES_PASSWORD=fitness

# --- Google ---------------------------------------------------------------
# Redirect URI to register: {BASE_URL}/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Apple ----------------------------------------------------------------
# Return URL to register on the Services ID: {BASE_URL}/auth/callback/apple
# (Apple requires HTTPS and a real domain — localhost is not accepted.)
# APPLE_CLIENT_ID is the Services ID, e.g. com.example.fitness.web
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the .p8 key with newlines escaped as \n, OR mount the file and set APPLE_PRIVATE_KEY_PATH
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_PATH=

# --- Local testing only ------------------------------------------------------
# Shows an email-only login form so you can try the app without SSO credentials.
DEV_LOGIN=0
